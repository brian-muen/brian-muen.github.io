function catalogNumber(code: string) {
  return parseInt(code.replace(/\D/g, ''), 10);
}

function codeLevel(code: string) {
  const n = catalogNumber(code);
  if (n >= 500) return 'grad';
  if (n >= 400) return 'upper';
  if (n >= 300) return 'mid';
  return 'intro';
}

function taughtBy(names: string[]) {
  if (names.length === 1) return names[0];
  if (names.length === 2) return `${names[0]} and ${names[1]}`;
  return `${names.slice(0, -1).join(', ')}, and ${names.at(-1)}`;
}
---

<Layout title="Academics — brian wang" description="Coursework at Princeton">
  <h1>Academics</h1>

  <section class="home-block">
  </section>

  <p class="course-legend">* currently taking</p>

  {groups.map((group) => (
    <section class="home-block course-group">
      <h2>{group.heading}</h2>
      <ul class="course-rows">
        {group.courses.map((course) => (
          <li>
            <span class:list={['course-code', `course-code--${codeLevel(course.code)}`]}>
              {course.current ? '*' : ''}{course.code}
            </span>
            <span class="course-detail">
              {course.title}
              {course.instructors && (
                <em> taught by {taughtBy(course.instructors)}</em>
              )}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
