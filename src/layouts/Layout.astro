---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const wordmark = 'brian wang';

const social = [
  { href: 'https://x.com/diffferance', label: 'Twitter' },
  { href: 'https://github.com/brian-muen', label: 'GitHub' },
];
---

<!doctype html>
<html lang="en" class="boot">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <noscript>
      <style>
        html.boot .wordmark span,
        html.boot .content > main,
        html.boot .content > .social { opacity: 1; filter: none; }
      </style>
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Theme"></button>
    <div class="content">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="brian wang">
          {wordmark.split('').map((ch) => (
            <span>{ch === ' ' ? '\u00a0' : ch}</span>
          ))}
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="social">
        {social.map((s) => (
          <a href={s.href} rel="me">{s.label}</a>
        ))}
      </footer>
    </div>
    <script is:inline>
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          document.documentElement.classList.remove('boot');
        });
      });
    </script>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');

      function current() {
        return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      }

      function syncLabel() {
        if (!btn) return;
        const dark = current() === 'dark';
        btn.setAttribute('aria-pressed', String(dark));
        btn.title = dark ? 'Switch to light' : 'Switch to dark';
      }

      function setTheme(next) {
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
        syncLabel();
      }

      syncLabel();
      btn?.addEventListener('click', () => {
        setTheme(current() === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
