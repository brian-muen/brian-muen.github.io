---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const isHome = Astro.url.pathname === '/';

const social = [
  { label: 'X', host: 'x.com/', handle: 'brianmuen', href: 'https://x.com/brianmuen' },
  { label: 'GitHub', host: 'github.com/', handle: 'brian-muen', href: 'https://github.com/brian-muen' },
  {
    label: 'LinkedIn',
    host: 'linkedin.com/in/',
    handle: 'brian-muen',
    href: 'https://www.linkedin.com/in/brian-muen/',
  },
];
---

<!doctype html>
<html lang="en" class:list={['boot', { home: isHome }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <noscript>
      <style>
        html.boot .wordmark-line,
        html.boot .content > main,
        html.boot main.home > *,
        html.boot .content > .social { opacity: 1; }
      </style>
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon-9.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="content">
      <header class="site-header">
        <div class="wordmark-line">
          <a href="/" class="wordmark">brian wang</a><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Theme">.</button>
        </div>
      </header>
      <main class:list={[{ home: isHome }]}>
        <slot />
      </main>
      <footer class="social">
        <nav class="webring" aria-label="Princeton webring" data-princeton-webring>
          <a
            class="webring-arrow"
            data-ring-prev
            href="https://firestoners.com/#https%3A%2F%2Fbrian-muen.github.io?nav=prev"
            aria-label="Previous website"
          >
            <svg viewBox="0 0 18 10" width="18" height="10" aria-hidden="true">
              <path d="M7.5 1.2 1.4 5l6.1 3.8M1.4 5H16.6" />
            </svg>
          </a>
          <a
            class="webring-home"
            href="https://firestoners.com/#https%3A%2F%2Fbrian-muen.github.io"
            aria-label="Explore the Princeton webring"
          >
            <img
              class="webring-mark"
              src="https://firestoners.com/icon.svg"
              alt=""
              width="32"
              height="32"
            />
          </a>
          <a
            class="webring-arrow"
            data-ring-next
            href="https://firestoners.com/#https%3A%2F%2Fbrian-muen.github.io?nav=next"
            aria-label="Next website"
          >
            <svg viewBox="0 0 18 10" width="18" height="10" aria-hidden="true">
              <path d="M10.5 1.2 16.6 5l-6.1 3.8M16.6 5H1.4" />
            </svg>
          </a>
        </nav>
        <p class="contact-line">
          Reach out at bw7520 [at] princeton [dot] edu, or find me at <span class="social-cycle" data-social-cycle>{social.map((item, i) => <a href={item.href} rel="me noreferrer" target="_blank" aria-label={`${item.label}: ${item.handle}`} class="social-cycle-link" data-state={i === 0 ? 'active' : 'waiting'}>{[...item.host, ...item.handle].map((ch, ci) => <span class:list={[{ 'social-cycle-host': ci < item.host.length }]} style={`--char:${ci}`}>{ch}</span>)}</a>)}</span>.
        </p>
      </footer>
    </div>
    <script is:inline src="https://firestoners.com/widget.js" defer></script>
    <script is:inline>
      (function () {
        var root = document.querySelector('[data-social-cycle]');
        if (!root) return;
        var links = Array.prototype.slice.call(root.querySelectorAll('.social-cycle-link'));
        if (!links.length) return;
        var index = 0;
        var previous = -1;
        var paused = false;
        var timer = 0;

        function measure() {
          var active = links[index];
          if (!active) return;
          root.style.width = active.offsetWidth + 'px';
        }

        function render() {
          links.forEach(function (link, i) {
            link.dataset.state = i === index ? 'active' : i === previous ? 'leaving' : 'waiting';
          });
          measure();
        }

        function advance() {
          previous = index;
          index = (index + 1) % links.length;
          render();
        }

        function stop() {
          window.clearInterval(timer);
        }

        function start() {
          stop();
          if (paused) return;
          timer = window.setInterval(advance, 2800);
        }

        root.addEventListener('pointerenter', function () {
          paused = true;
          stop();
        });
        root.addEventListener('pointerleave', function () {
          paused = false;
          start();
        });
        links.forEach(function (link, i) {
          link.addEventListener('focus', function () {
            paused = true;
            stop();
            if (i === index) return;
            previous = index;
            index = i;
            render();
          });
          link.addEventListener('blur', function () {
            paused = false;
            start();
          });
        });

        render();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
        start();
      })();
    </script>
    <script is:inline>
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          document.documentElement.classList.remove('boot');
        });
      });
    </script>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');

      function current() {
        return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      }

      function syncLabel() {
        if (!btn) return;
        const dark = current() === 'dark';
        btn.setAttribute('aria-pressed', String(dark));
        btn.title = dark ? 'Switch to light' : 'Switch to dark';
      }

      function setTheme(next) {
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
        syncLabel();
      }

      syncLabel();
      btn?.addEventListener('click', () => {
        setTheme(current() === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
